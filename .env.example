# Copy to .env for local overrides (docker compose reads .env automatically).
# Nothing here is required for `docker compose up` — these are the defaults it already uses.
# .env itself is gitignored; this file documents the shape without carrying real values.

# --- Deployed environments set this instead of the DB_* vars below -----------------
# Provider-style URL (postgres://user:pass@host:port/db). Parsed into JDBC form, with
# sslmode=require added if absent. Leave unset locally.
# DATABASE_URL=

# --- Local / docker compose -------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wallet
DB_USER=wallet
DB_PASSWORD=wallet
DB_POOL_SIZE=15
PORT=8080

# --- Signs the per-user bearer tokens ---------------------------------------------
# MUST be overridden in any deployed environment: `openssl rand -base64 32`.
# Changing it invalidates every token already issued.
AUTH_TOKEN_SECRET=local-dev-secret-not-for-production
